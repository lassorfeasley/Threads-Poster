# Workspace data trees hold downloaded videos, clips and waveforms — multiple
# GB, and the scheduler reads none of it (clips come from Supabase signed URLs).
data/
workspaces/*/data/
workspaces/.shared/

# Secrets reach the container through `fly secrets set`, never the image.
.env
.env.example
workspaces/*/.env

# Local tooling. (requirements.txt and assets/ stay in the context for the
# dashboard image, Dockerfile.dashboard; the scheduler image never copies them.)
.venv/
venv/

.git/
.github/
__pycache__/
**/__pycache__/
*.pyc
*.db
*.db-shm
*.db-wal
.DS_Store
README.md
demo/
docs/
lab/
tests/
