# --- YouTube Data API v3 (discovery only; no downloading happens with this key) ---
YOUTUBE_API_KEY=

# --- LLM (relevance scoring, comment classification, reply drafts) ---
ANTHROPIC_API_KEY=

# --- Database ---
# Leave empty (or omit) to use local SQLite at data/app.db — recommended for
# day-to-day development on this machine (page loads stay under ~100ms).
# For a shared / product deployment use Supabase Postgres (Project Settings →
# Database). Remote DBs add ~100ms per query; the app batches queries for that
# case, but local SQLite is still much snappier for UI work.
# DATABASE_URL=postgresql+psycopg2://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# --- Supabase Storage (hosts trimmed clips so Threads can fetch them by URL) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Threads / Meta app (create at developers.facebook.com, Threads use case) ---
THREADS_APP_ID=
THREADS_APP_SECRET=
# Must match a redirect URI registered on the Meta app (HTTPS required by Meta).
THREADS_REDIRECT_URI=https://localhost/threads/callback

# --- Instagram Reels (optional; same Meta app, Instagram API with Instagram Login) ---
# Professional Instagram account required; add it as an Instagram Tester on the app.
# Scopes: instagram_business_basic, instagram_business_content_publish.
# Insights/analytics can be added later — publishing works without them.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://localhost/instagram/callback

# --- LinkedIn company page (Community Management API) ---
# From the LinkedIn app's Auth tab. The redirect URL must be registered there;
# pointing it at the dashboard (http://localhost:8321/linkedin/callback)
# completes the connection automatically, anything else means pasting the code.
# The secret is also needed wherever the scheduler runs, to refresh the token.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8321/linkedin/callback
# Optional: override the requested scopes (space-separated).
# LINKEDIN_SCOPES=w_organization_social r_organization_social rw_organization_admin

# --- Giphy (GIF search for replies; free key at developers.giphy.com) ----------
GIPHY_API_KEY=
