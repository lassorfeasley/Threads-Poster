# The hosted dashboard: the browser UI for one workspace, behind the login
# (app/web/auth.py). Deploy with: fly deploy -c fly.dashboard.toml
#
# Differs from the scheduler image (Dockerfile) in what it carries:
# - the full web stack, and ffmpeg for trimming, captions, vertical renders
#   and stills. Not faster-whisper: transcription, like downloading, happens
#   on a machine with a home connection (ARCHIVE_ON_THIS_MACHINE=off below).
# - a volume for the workspace's data tree. It is a cache: every file it holds
#   is in Supabase Storage or can be rebuilt (SHARED_WORKSPACE=on, see
#   app/datasync.py), so losing it costs downloads, not data.
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends tzdata ffmpeg fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

ENV TZ=America/New_York \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY requirements.txt .
RUN grep -v -i "faster-whisper" requirements.txt > /tmp/requirements.txt \
    && pip install --no-cache-dir -r /tmp/requirements.txt

COPY app/ ./app/
COPY assets/ ./assets/
COPY workspaces/ ./workspaces/
COPY workspaces.yaml run.py ./

# Root on purpose: the Fly volume mounts root-owned, and the VM is this
# process alone.
CMD ["sh", "-c", "exec python run.py dashboard --workspace ${WORKSPACE} --host 0.0.0.0 --port 8080 --no-reload"]
