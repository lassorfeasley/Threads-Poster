{
  "rewrites": [
    { "source": "/", "destination": "/landing.html" },
    { "source": "/keynote", "destination": "/keynote.html" },
    { "source": "/book", "destination": "/book.html" },
    { "source": "/privacy", "destination": "/api/legal?kind=privacy" },
    { "source": "/terms", "destination": "/api/legal?kind=terms" }
  ],
  "redirects": [
    { "source": "/signin", "destination": "https://app.continuity.marketing/login", "permanent": false },
    { "source": "/login", "destination": "https://app.continuity.marketing/login", "permanent": false }
  ],
  "headers": [
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
